{
  "name": "fastifyv5-multer",
  "description": "Fastify plugin for handling `multipart/form-data`.",
  "version": "1.0.0",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "contributors": [
    "Maksim Sinik <maksim@sinik.it>",
    "Hage Yaapa <captain@hacksparrow.com> (http://www.hacksparrow.com)",
    "Jaret Pfluger <https://github.com/jpfluger>",
    "Linus Unnebäck <linus@folkdatorn.se>"
  ],
  "license": "MIT",
  "repository": "https://github.com/fox1t/fastify-multer",
  "keywords": [
    "form",
    "post",
    "multipart",
    "form-data",
    "formdata",
    "fastify",
    "middleware"
  ],
  "dependencies": {
    "@fastify/busboy": "^3.1.1",
    "append-field": "^2.0.0",
    "fastify-plugin": "^5.0.1",
    "on-finished": "^2.4.1",
    "type-is": "~2.0.0",
    "xtend": "^4.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.10",
    "@types/on-finished": "^2.3.4",
    "@types/type-is": "^1.6.7",
    "@types/xtend": "4.0.6",
    "@vitest/coverage-istanbul": "3.0.4",
    "fastify": "^5.2.1",
    "form-data": "^4.0.1",
    "fs-temp": "^2.0.1",
    "on-finished": "^2.4.1",
    "prettier": "~3.4.2",
    "rimraf": "^6.0.1",
    "tempy": "^3.1.0",
    "testdata-w3c-json-form": "~1.0.0",
    "ts-node": "^10.9.2",
    "tslint": "^6.1.3",
    "tslint-config-prettier": "^1.18.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.4"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "lib/",
    "src",
    "typings/"
  ],
  "scripts": {
    "prebuild": "npm run clean-build && npm run lint",
    "build": "tsc -p ./tsconfig.json",
    "clean-build": "rimraf ./lib && mkdir lib",
    "prettier": "prettier --log-level warn --write \"src/**/*.{ts,tsx}\"",
    "prelint": "npm run prettier",
    "lint": "tslint --fix -c tslint.json -t stylish -p ./tsconfig.json",
    "update": "npx npm-check -u",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "coverage": "vitest run --coverage"
  }
}